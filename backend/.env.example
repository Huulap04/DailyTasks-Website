# Local server port
PORT=5000

# Copy the Session Pooler connection string from Supabase Connect.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_DATABASE_PASSWORD@aws-REGION.pooler.supabase.com:5432/postgres

# Generate a random secret of at least 32 characters. Never commit the real value.
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Comma-separated origins are supported when more than one frontend is allowed.
FRONTEND_URL=http://localhost:5173
